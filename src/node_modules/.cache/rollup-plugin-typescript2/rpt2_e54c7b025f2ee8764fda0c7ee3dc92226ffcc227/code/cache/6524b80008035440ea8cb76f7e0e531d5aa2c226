{"code":"import { data } from \"../../database/mysql\";\nexport const getNickname = (uid) => {\n    return new Promise((resolve, reject) => {\n        const sql = 'SELECT * FROM chars WHERE uid = ?';\n        data.query(sql, [uid], (err, result) => {\n            if (err)\n                reject(err);\n            else {\n                const { firstname, lastname } = result[0];\n                const fullName = `${firstname || ''} ${lastname || ''}`.trim();\n                resolve(fullName);\n            }\n        });\n    });\n};\n","references":["D:/Projects/REAL-RP/src/server/database/mysql.ts"]}
