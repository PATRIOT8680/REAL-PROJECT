{"code":"export const playAnim = (player, dict, name, flag, duration) => {\n    if (!player)\n        return;\n    if (!dict || !name || !flag || !duration)\n        return;\n    if (duration <= 0)\n        return;\n    player.playAnimation(dict, name, 1, flag);\n    setTimeout(() => {\n        player.stopAnimation();\n    }, duration);\n};\n","references":[]}
