{"code":"const updateDiscord = () => {\n    const player = mp.players.local;\n    const title = 'Играет на REAL RP';\n    let subtitle;\n    if (player.getVariable('player_spawned') === undefined) {\n        subtitle = 'Входит в аккаунт';\n    }\n    else if (player.inVehicle.state !== undefined) {\n        if (player.inVehicle.seat !== undefined) {\n            subtitle = 'В транспорте с водителем';\n        }\n        else {\n            subtitle = 'Едет на транспорте';\n        }\n    }\n    else {\n        subtitle = 'Странствует по штату';\n    }\n    mp.discord.update(title, subtitle);\n};\nsetInterval(updateDiscord, 10000);\n","references":[]}
