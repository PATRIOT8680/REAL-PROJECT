s, mp.players.local, 16);\n    mp.game.graphics.drawLine(coordCam.x, coordCam.y, coordCam.z, raycastPos.x, raycastPos.y, raycastPos.z, 255, 255, 255, 255);\n    if (raycastResult && raycastResult.entity) {\n        const entityHandle = raycastResult.entity;\n        //const object = mp.objects.atHandle(entityHandle)\n        //mp.console.logWarning(`entityHandle: ${JSON.stringify(entityHandle)}`)\n        //mp.console.logWarning(`obj: ${JSON.stringify(object)}`)\n        // const object = entity as ObjectMp\n        const objId = entityHandle.remoteId;\n        const hasObjId = objId !== undefined || objId !== null;\n        mp.console.logWarning(`worldItems: ${objId !== undefined && worldItems.has(objId)}`);\n        //\n        if (hasObjId && worldItems.has(objId)) {\n            mp.console.logWarning('HIT! HIT! HIT!');\n        }\n    }\n};\n","references":["D:/Projects/REAL-RP/src/client/utils/rce.ts","D:/Projects/REAL-RP/src/shared/types/items.ts"]}
